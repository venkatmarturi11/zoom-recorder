# ==============================================================================
# ZOOM TELEGRAM TAB RECORDER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Settings (Obtain via @BotFather on Telegram)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz123456789

# Authorized Telegram user IDs permitted to control the recorder (comma-separated)
# Send /start to @userinfobot to find your numerical Telegram user ID
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Administrator IDs with elevated permissions (comma-separated)
ADMIN_USER_IDS=123456789

# ------------------------------------------------------------------------------
# 2. Database Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/recorder.db
# For PostgreSQL: postgresql+asyncpg://user:password@host:5432/zoom_recorder

# ------------------------------------------------------------------------------
# 3. External Media Storage (Recommended: Cloudflare R2 Free Tier 10GB)
# ------------------------------------------------------------------------------
# Options: "local" (for local testing) or "s3" (production object storage)
STORAGE_PROVIDER=local

# Local storage folder
LOCAL_STORAGE_DIR=./recordings

# S3 / Cloudflare R2 Credentials (leave blank if STORAGE_PROVIDER=local)
# For Cloudflare R2, format: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=zoom-recordings
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION_NAME=auto
S3_URL_EXPIRATION_SECONDS=86400

# Remove temporary local file once successfully uploaded to external S3
CLEANUP_LOCAL_FILES_AFTER_UPLOAD=true

# ------------------------------------------------------------------------------
# 4. Recording & Browser Environment
# ------------------------------------------------------------------------------
BOT_DISPLAY_NAME=Zoom Recorder Bot (Authorized Assistant)
MAX_RECORDING_DURATION_SECONDS=7200
RECORDING_FPS=30
RECORDING_RESOLUTION=1280x720
FFMPEG_PATH=ffmpeg
MAX_CONCURRENT_JOBS=1

# Container / Browser settings
BROWSER_HEADLESS=true
DISPLAY=:99
CAPTURE_DRIVER=auto

# ------------------------------------------------------------------------------
# 5. Security & Persistent Session Encryption
# ------------------------------------------------------------------------------
# 32-byte Fernet base64 key or arbitrary secret string used to encrypt saved Zoom cookies
APP_SECRET_KEY=generate_a_secure_random_string_or_fernet_key_here

# ------------------------------------------------------------------------------
# 6. Webhook Mode (Optional, leave blank for Polling)
# ------------------------------------------------------------------------------
# WEBHOOK_URL=https://your-app-name.onrender.com
# WEBHOOK_PORT=8080

# ------------------------------------------------------------------------------
# 7. Official Zoom OAuth 2.0 Authentication (https://marketplace.zoom.us/)
# ------------------------------------------------------------------------------
# Create a General App on Zoom App Marketplace -> OAuth
# Set Redirect URL for OAuth to: <PUBLIC_APP_URL>/oauth/callback
# Add Scope: user:read
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional: defaults to "user:read"
ZOOM_OAUTH_SCOPE=user:read
# Public URL used for OAuth redirect (e.g., https://your-app.onrender.com or http://localhost:8080)
PUBLIC_APP_URL=http://localhost:8080
